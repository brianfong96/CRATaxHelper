# CRA Tax Helper — PRODUCTION secrets
#
# This file is only needed for deploying to aether-data.net via deploy.ps1.
# LOCAL mode needs NO .env file at all — just run: docker compose up
#
# Usage:
#   1. Copy this file to .env  (it is gitignored)
#   2. Fill in the values below
#   3. Run: .\scripts\deploy.ps1
#
# NEVER commit .env to git.

# ── Required for production ───────────────────────────────────────────────────

# Fernet encryption key — encrypts all form data at rest in Archive.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Hosted Aether auth requires the complete audience-scoped keyring generated by
# Aether/scripts/sync-auth-scope-secrets.ps1. These are runtime variable names;
# scripts/deploy.ps1 reads their CRA_TAXHELPER_AUTH_* source equivalents from
# the Aether .env and injects them into Atlas. Never substitute SESSION_SECRET.
AETHER_AUTH_PREVIOUS_KEY_ID=
AETHER_AUTH_PREVIOUS_SECRET_HEX=
AETHER_AUTH_KEY_ID=
AETHER_AUTH_SECRET_HEX=
AETHER_AUTH_NEXT_KEY_ID=
AETHER_AUTH_NEXT_SECRET_HEX=

# ── Optional production overrides ────────────────────────────────────────────

# Restrict access to specific email addresses (comma-separated).
# Leave empty to allow any authenticated Aether user.
# ALLOWED_EMAILS=you@example.com,colleague@example.com

# Gateway base URL — used for the login redirect and for the live
# POST /auth/session/introspect revocation check performed after a session
# cookie passes local cryptographic validation (fail closed on
# inactive/timeout/unavailable). Defaults to https://api.aether-data.net.
# GATEWAY_URL=https://api.aether-data.net

# Sessions must use auth_version=2, typ=session, aud=cra-taxhelper, and the
# canonical three-day UTC kid. They expire after at most six hours. There is no
# legacy, master-secret, or static-key fallback.
